# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=
HAZARD_STORAGE_BACKEND=sqlite

# Dashboard login (defaults to admin / admin123 if not set)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123

